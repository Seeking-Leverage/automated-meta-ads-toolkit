# Never commit real credentials
.env
clients/*/.env
clients/*/.env.local

# Python
__pycache__/
*.pyc

# OS / Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Launch and ops logs stay on the machine. Command text can be sensitive.
*.log

# Insights snapshots include spend and are local-only.
clients/*/campaigns/*/insights/**/*.json
