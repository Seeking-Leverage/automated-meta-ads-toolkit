#!/usr/bin/env bash
# Meta Ads CLI Wrapper
#
# This script is the main entry point for running Meta Ads commands.
# It loads client-specific credentials and runs the underlying Python CLI.
#
# Usage:
#   meta <client-name> [command...]
#
# Example:
#   meta acme-co -o json --no-input ads campaign list
#   meta acme-co -o json --no-input ads --ad-account-id act_XXX campaign create \
#     --name "Example" --objective outcome_traffic --daily-budget 5000
#
# How to customize for your company:
#   1. Create a folder under clients/ with your company name
#   2. Copy .env.example into that folder and rename it to .env
#   3. Fill in your own META_ADS_ACCESS_TOKEN and META_ADS_ACCOUNT_ID
#   4. Run commands using your client folder name

set -euo pipefail

HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLIENTS_DIR="$HARNESS_DIR/clients"

# Get client name from first argument
CLIENT="${1:-}"

if [[ -z "$CLIENT" || "$CLIENT" == --* ]]; then
  echo "error: Please specify a client name." >&2
  echo "Example: meta client-example -o json --no-input ads campaign list" >&2
  exit 2
fi

shift

if ! [[ "$CLIENT" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
  echo "error: invalid client name '$CLIENT' (letters, numbers, - and _ only)" >&2
  exit 2
fi

ENV_FILE="$CLIENTS_DIR/$CLIENT/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "error: No configuration found for client '$CLIENT'" >&2
  echo "Expected file: $ENV_FILE" >&2
  echo "" >&2
  echo "To fix this:" >&2
  echo "  1. Go to clients/ folder" >&2
  echo "  2. Create or copy a client folder" >&2
  echo "  3. Create a .env file with your credentials" >&2
  exit 2
fi

# Resolve 1Password references (op://...) if present.
# Comment lines are ignored so the example in .env.example does not force `op`.
if grep -vE '^[[:space:]]*#' "$ENV_FILE" | grep -q 'op://' && [[ -z "${META_OP_RESOLVED:-}" ]]; then
  command -v op >/dev/null 2>&1 || { echo "error: $ENV_FILE uses op:// references but the 1Password CLI 'op' is not installed" >&2; exit 127; }
  exec env META_OP_RESOLVED=1 op run --env-file="$ENV_FILE" -- "$0" "$CLIENT" "$@"
fi

# Load client credentials (skipped when op run already injected them)
if [[ -z "${META_OP_RESOLVED:-}" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

if [[ -z "${META_ADS_ACCESS_TOKEN:-}" || -z "${META_ADS_ACCOUNT_ID:-}" ]]; then
  echo "error: META_ADS_ACCESS_TOKEN and META_ADS_ACCOUNT_ID are missing in $ENV_FILE" >&2
  exit 2
fi

# Export variables expected by the Python CLI
export ACCESS_TOKEN="$META_ADS_ACCESS_TOKEN"
export AD_ACCOUNT_ID="$META_ADS_ACCOUNT_ID"

# Location of the Python Meta Ads CLI project
# You can override this in the client's .env file if needed
PROJECT_DIR="${META_ADS_CLI_PROJECT:-$HOME/meta-ads-cli}"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "error: Meta Ads CLI project not found at: $PROJECT_DIR" >&2
  echo "" >&2
  echo "Options:" >&2
  echo "  - Set META_ADS_CLI_PROJECT in clients/$CLIENT/.env" >&2
  echo "  - Or install the CLI project at the default location" >&2
  exit 127
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "error: 'uv' is not installed. Please install it from: https://docs.astral.sh/uv/" >&2
  exit 127
fi

# Hard spend ceiling: block any budget flag above the client's cap (fail closed if cap unset).
# Campaign and ad set create/update all use --daily-budget and --lifetime-budget (meta-ads 1.1.0).
# Click rejects shortened flags (--daily-bud) before any API call. There is no params file
# on those commands; --targeting and --promoted-object JSON are not budget fields.
check_budget_cap() {
  local cap_var="$1" flag="$2"; shift 2
  local cap="${!cap_var:-}" prev="" val
  for arg in "$@"; do
    val=""
    if [[ "$prev" == "$flag" ]]; then val="$arg"
    elif [[ "$arg" == "$flag="* ]]; then val="${arg#*=}"
    fi
    if [[ -n "$val" ]]; then
      if [[ -z "$cap" ]]; then
        echo "error: $flag used but $cap_var is not set in clients/$CLIENT/.env" >&2; exit 3
      fi
      if ! [[ "$val" =~ ^[0-9]+$ ]] || (( val > cap )); then
        echo "error: $flag $val exceeds $cap_var=$cap for client '$CLIENT'" >&2; exit 3
      fi
    fi
    prev="$arg"
  done
}
check_budget_cap META_MAX_DAILY_BUDGET_CENTS --daily-budget "$@"
check_budget_cap META_MAX_LIFETIME_BUDGET_CENTS --lifetime-budget "$@"

cd "$PROJECT_DIR"
exec uv run meta "$@"
