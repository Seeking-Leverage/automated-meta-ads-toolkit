#!/usr/bin/env bash
# Meta Ads CLI Wrapper

set -euo pipefail

HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLIENTS_DIR="$HARNESS_DIR/clients"

CLIENT=""
if [[ "${1:-}" == "--client" ]]; then
  CLIENT="${2:-}"
  shift 2
elif [[ -n "${1:-}" && "${1}" != --* ]]; then
  CLIENT="$1"
  shift
fi

if [[ -z "$CLIENT" ]]; then
  echo "error: No client specified. Example: meta client-example campaigns list" >&2
  exit 2
fi

ENV_FILE="$CLIENTS_DIR/$CLIENT/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "error: No config found for client '$CLIENT'" >&2
  exit 2
fi

set -a
source "$ENV_FILE"
set +a

export ACCESS_TOKEN="$META_ADS_ACCESS_TOKEN"
export AD_ACCOUNT_ID="$META_ADS_ACCOUNT_ID"

PROJECT_DIR="${META_ADS_CLI_PROJECT:-$HOME/meta-ads-cli}"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "error: Meta Ads CLI project not found at $PROJECT_DIR" >&2
  exit 127
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "error: uv not found. Install it from https://docs.astral.sh/uv/" >&2
  exit 127
fi

cd "$PROJECT_DIR"
exec uv run meta "$@"
