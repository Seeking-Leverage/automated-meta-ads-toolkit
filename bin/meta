#!/usr/bin/env bash
# Meta Ads CLI Wrapper
#
# Loads one client's credentials and runs the pinned meta-ads CLI.
#
# Usage:
#   meta <client-name> [command...]
#
# Example:
#   meta acme-co -o json --no-input ads campaign list
#   meta acme-co -o json --no-input ads --ad-account-id act_XXX campaign create \
#     --name "Example" --objective outcome_traffic --daily-budget 5000 --status PAUSED
#
# Safety:
#   - .env is parsed. It is not executed as shell, and only META_* keys are kept.
#   - --daily-budget and --lifetime-budget are the only budget flags. Anything
#     else starting with --daily or --lifetime is refused.
#   - --status must be PAUSED. ACTIVE is scripts/activate-campaign.sh --confirm.

set -euo pipefail

HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/client-env.sh
source "$HARNESS_DIR/bin/lib/client-env.sh"
CLIENTS_DIR="$HARNESS_DIR/clients"

CLIENT="${1:-}"

if [[ -z "$CLIENT" || "$CLIENT" == --* ]]; then
  echo "error: Please specify a client name." >&2
  echo "Example: meta client-example -o json --no-input ads campaign list" >&2
  exit 2
fi

shift

validate_client_name "$CLIENT" || exit 2

ENV_FILE="$CLIENTS_DIR/$CLIENT/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "error: No configuration found for client '$CLIENT'" >&2
  echo "Expected file: $ENV_FILE" >&2
  echo "" >&2
  echo "To fix this:" >&2
  echo "  1. Go to clients/ folder" >&2
  echo "  2. Create or copy a client folder" >&2
  echo "  3. Create a .env file with your credentials" >&2
  exit 2
fi

# A parent shell must not be able to raise this client's ceiling.
# When 1Password already injected the file, do not wipe those values.
if [[ -z "${META_OP_RESOLVED:-}" ]]; then
  clear_budget_caps
  reexec_if_op_env "$ENV_FILE" "$CLIENT" "$@"
  load_client_env "$ENV_FILE"
fi

if [[ -z "${META_ADS_ACCESS_TOKEN:-}" || -z "${META_ADS_ACCOUNT_ID:-}" ]]; then
  echo "error: META_ADS_ACCESS_TOKEN and META_ADS_ACCOUNT_ID are missing in $ENV_FILE" >&2
  exit 2
fi

export ACCESS_TOKEN="$META_ADS_ACCESS_TOKEN"
export AD_ACCOUNT_ID="$META_ADS_ACCOUNT_ID"

# Policy checks run before the CLI lookup so a bad budget or status
# never depends on the toolchain being installed.

# Fail closed on flags that look like budgets but are not the two exact names.
# Click rejects some abbreviations today; the wrapper does not depend on that.
reject_unknown_budget_flags() {
  local arg name
  for arg in "$@"; do
    if [[ "$arg" == --daily* || "$arg" == --lifetime* ]]; then
      name="${arg%%=*}"
      if [[ "$name" != "--daily-budget" && "$name" != "--lifetime-budget" ]]; then
        echo "error: unrecognized budget flag '$name' (only --daily-budget and --lifetime-budget are allowed)" >&2
        exit 3
      fi
    fi
  done
}

# PAUSED is the only status this wrapper sends, unless activate-campaign.sh
# set META_ALLOW_ACTIVATE=1 for an ACTIVE update.
check_status_flag() {
  local arg prev="" val upper
  for arg in "$@"; do
    val=""
    if [[ "$prev" == "--status" ]]; then
      val="$arg"
    elif [[ "$arg" == --status=* ]]; then
      val="${arg#*=}"
    fi
    if [[ -n "$val" ]]; then
      upper=$(printf '%s' "$val" | tr '[:lower:]' '[:upper:]')
      if [[ "$upper" == "PAUSED" ]]; then
        :
      elif [[ "$upper" == "ACTIVE" && "${META_ALLOW_ACTIVATE:-}" == "1" ]]; then
        :
      elif [[ "$upper" == "ACTIVE" ]]; then
        echo "error: --status ACTIVE is blocked. Run: scripts/activate-campaign.sh --confirm <client> <slug>" >&2
        exit 3
      else
        echo "error: --status $val is blocked (only PAUSED is allowed through meta)" >&2
        exit 3
      fi
    fi
    prev="$arg"
  done
}

# Hard spend ceiling. Fail closed when the flag is present and the cap is unset.
check_budget_cap() {
  local cap_var="$1" flag="$2"
  shift 2
  local cap="${!cap_var:-}" prev="" val
  for arg in "$@"; do
    val=""
    if [[ "$prev" == "$flag" ]]; then
      val="$arg"
    elif [[ "$arg" == "$flag="* ]]; then
      val="${arg#*=}"
    fi
    if [[ -n "$val" ]]; then
      if [[ -z "$cap" ]]; then
        echo "error: $flag used but $cap_var is not set in clients/$CLIENT/.env" >&2
        exit 3
      fi
      if ! [[ "$cap" =~ ^[0-9]+$ ]]; then
        echo "error: $cap_var in clients/$CLIENT/.env must be an integer number of cents" >&2
        exit 3
      fi
      if ! [[ "$val" =~ ^[0-9]+$ ]] || ((10#$val > 10#$cap)); then
        echo "error: $flag $val exceeds $cap_var=$cap for client '$CLIENT'" >&2
        exit 3
      fi
    fi
    prev="$arg"
  done
}

reject_unknown_budget_flags "$@"
check_status_flag "$@"
check_budget_cap META_MAX_DAILY_BUDGET_CENTS --daily-budget "$@"
check_budget_cap META_MAX_LIFETIME_BUDGET_CENTS --lifetime-budget "$@"

PROJECT_DIR="${META_ADS_CLI_PROJECT:-$HOME/meta-ads-cli}"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "error: Meta Ads CLI project not found at: $PROJECT_DIR" >&2
  echo "" >&2
  echo "Options:" >&2
  echo "  - Set META_ADS_CLI_PROJECT in clients/$CLIENT/.env" >&2
  echo "  - Or install the CLI project at the default location" >&2
  exit 127
fi

require_pinned_cli "$PROJECT_DIR"

if ! command -v uv >/dev/null 2>&1; then
  echo "error: 'uv' is not installed. Please install it from: https://docs.astral.sh/uv/" >&2
  exit 127
fi

cd "$PROJECT_DIR"
exec uv run meta "$@"
